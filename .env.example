# Скопируйте в .env, только если его ещё нет. Кодировка UTF-8 без BOM.
# Окружение процесса имеет приоритет; после изменений перезапустите API/CLI.
# Относительный путь отсчитывается от корня проекта. Каталоги создаются при импорте.
# Для Windows используйте / либо одинарные кавычки: 'C:\My Project\data\theses.sqlite3'.
DATABASE_PATH=data/theses.sqlite3

# DEBUG, INFO, WARNING, ERROR, CRITICAL или NOTSET.
LOG_LEVEL=INFO

# false: BM25 без Ollama. true: startup проверяет локальную BGE-M3,
# HTTP-импорт вычисляет векторы. Режим запроса задаётся полем search_mode в JSON.
OLLAMA_ENABLED=false

# Только HTTP loopback: 127.0.0.1, localhost или [::1]; без пути API и учётных данных.
OLLAMA_BASE_URL=http://127.0.0.1:11434

# Конечный положительный таймаут сетевых операций запроса к Ollama, в секундах.
OLLAMA_TIMEOUT_SECONDS=120
